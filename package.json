    "dsh",
    "liquid-glass",
    "analog",
    "glass",
    "composer",
    "input",
    "ui",
    "theme",
    "bubble"
  ],
  "license": "MIT",
  "author": "Siloet-phy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siloet-phy/analog-liquid-glass-for-dsh.git"
  },
  "homepage": "https://github.com/Siloet-phy/analog-liquid-glass-for-dsh#readme",
  "bugs": {
    "url": "https://github.com/Siloet-phy/analog-liquid-glass-for-dsh/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
